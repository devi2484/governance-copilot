# Copy this file to a new file named ".env" (no ".example") and put your
# real Groq API key on the line below. Get a free key at console.groq.com

GROQ_API_KEY=paste_groq_key_here

# NEVER commit the real .env file to GitHub — it contains your secret key.
# The .gitignore file in this project already excludes it for you.
